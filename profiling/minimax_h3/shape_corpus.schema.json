{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MiniMax H3 runtime shape corpus row",
  "type": "object",
  "required": [
    "workload_id",
    "run_id",
    "provenance",
    "module_path",
    "scope",
    "op_role",
    "phase",
    "active_num_layers",
    "full_model_reference_count",
    "m",
    "n",
    "k",
    "input",
    "output",
    "weight",
    "observed_call_count_per_rank"
  ],
  "$defs": {
    "tensor_meta": {
      "type": "object",
      "required": [
        "shape",
        "stride",
        "dtype",
        "contiguous",
        "storage_offset",
        "align16",
        "align256"
      ],
      "properties": {
        "shape": {
          "type": [
            "array",
            "null"
          ]
        },
        "stride": {
          "type": [
            "array",
            "null"
          ]
        },
        "dtype": {
          "type": [
            "string",
            "null"
          ]
        },
        "contiguous": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "storage_offset": {
          "type": [
            "integer",
            "null"
          ]
        },
        "align16": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "align256": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    }
  },
  "properties": {
    "workload_id": {
      "type": "string",
      "description": "join key into raw_gemm rows"
    },
    "run_id": {
      "type": "string"
    },
    "provenance": {
      "enum": [
        "runtime",
        "static"
      ]
    },
    "module_path": {
      "type": "string"
    },
    "scope": {
      "enum": [
        "main_transformer",
        "text_refiner",
        "final"
      ]
    },
    "op_role": {
      "type": "string"
    },
    "phase": {
      "enum": [
        "Fwd",
        "RecomputeFwd",
        "Dgrad",
        "Wgrad"
      ]
    },
    "active_num_layers": {
      "type": "integer"
    },
    "checkpoint_num_layers": {
      "type": "integer"
    },
    "full_model_reference_count": {
      "type": "integer",
      "description": "main=50, text_refiner=2, final=1"
    },
    "m": {
      "type": [
        "integer",
        "null"
      ]
    },
    "n": {
      "type": [
        "integer",
        "null"
      ]
    },
    "k": {
      "type": [
        "integer",
        "null"
      ]
    },
    "input": {
      "$ref": "#/$defs/tensor_meta"
    },
    "output": {
      "$ref": "#/$defs/tensor_meta"
    },
    "weight": {
      "$ref": "#/$defs/tensor_meta"
    },
    "observed_call_count_per_rank": {
      "type": "object"
    },
    "executed_dtype": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_equivalent_workload_id": {
      "type": "string"
    },
    "wgrad_operands_paired": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "wgrad_lhs": {
      "$ref": "#/$defs/tensor_meta"
    },
    "wgrad_output_is_real_grad": {
      "type": "boolean"
    }
  }
}
